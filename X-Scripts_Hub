--// Invisibility
local Invisible = false

local function SetInvisibility(enabled)
    Invisible = enabled

    local character = Player.Character
    if not character then return end

    for _, object in ipairs(character:GetDescendants()) do
        if object:IsA("BasePart") then
            object.LocalTransparencyModifier = enabled and 1 or 0
        elseif object:IsA("Decal") then
            object.Transparency = enabled and 1 or 0
        end
    end
end

PlayerTab:CreateSection("Appearance")

PlayerTab:CreateToggle({
    Name = "Enable Invisibility",
    CurrentValue = false,
    Flag = "Invisibility",
    Callback = function(value)
        SetInvisibility(value)
    end
})

-- Re-apply visual state after respawn.
Player.CharacterAdded:Connect(function(character)
    character:WaitForChild("Humanoid", 5)

    if Invisible then
        task.wait(0.25)
        SetInvisibility(true)
    end
end)

--// Player highlights
local HighlightEnabled = false

local function RemoveHighlight(character)
    local highlight = character and character:FindFirstChild("XScriptsHighlight")
    if highlight then
        highlight:Destroy()
    end
end

local function HighlightCharacter(character)
    if not HighlightEnabled or not character then return end
    if character:FindFirstChild("XScriptsHighlight") then return end

    local highlight = Instance.new("Highlight")
    highlight.Name = "XScriptsHighlight"
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 0
    highlight.Parent = character
end

local function HighlightPlayer(player)
    if player == Player then return end

    if player.Character then
        HighlightCharacter(player.Character)
    end

    player.CharacterAdded:Connect(function(character)
        if HighlightEnabled then
            HighlightCharacter(character)
        end
    end)
end

PlayerTab:CreateSection("Player Highlights")

PlayerTab:CreateToggle({
    Name = "Enable Player Highlights",
    CurrentValue = false,
    Flag = "PlayerHighlights",
    Callback = function(value)
        HighlightEnabled = value

        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= Player then
                if value then
                    HighlightPlayer(player)
                elseif player.Character then
                    RemoveHighlight(player.Character)
                end
            end
        end
    end
})

Players.PlayerAdded:Connect(function(player)
    if HighlightEnabled then
        HighlightPlayer(player)
    end
end)

Players.PlayerRemoving:Connect(function(player)
    if player.Character then
        RemoveHighlight(player.Character)
    end
end)

