local DebugTab = Window:CreateTab("Debug", 6031075931)

DebugTab:CreateSection("Performance")

local FPSLabel = DebugTab:CreateLabel("FPS: calculating...")
DebugTab:CreateLabel("Player: " .. Player.Name)
DebugTab:CreateLabel("UserId: " .. Player.UserId)

local frames = 0
local lastTime = tick()
local currentFPS = 0

RunService.RenderStepped:Connect(function()
    frames += 1

    if tick() - lastTime >= 1 then
        currentFPS = frames
        frames = 0
        lastTime = tick()

        if FPSLabel and FPSLabel.Set then
            FPSLabel:Set("FPS: " .. currentFPS)
        end
    end
end)

--// Rayfield-only live console
local Logs = {}

local function AddLog(message, logType)
    local entry = "[" .. tostring(logType) .. "] " .. tostring(message)
    table.insert(Logs, entry)

    -- Keep the log window reasonably small.
    if #Logs > 100 then
        table.remove(Logs, 1)
    end
end

local ConsoleTab = Window:CreateTab("Debug Console", 6031075931)

ConsoleTab:CreateSection("Live Logs")

local ConsoleParagraph = ConsoleTab:CreateParagraph({
    Title = "Developer Console",
    Content = "No logs yet."
})

local function RefreshConsole()
    if not ConsoleParagraph or not ConsoleParagraph.Set then
        return
    end

    local content = #Logs > 0 and table.concat(Logs, "\n") or "No logs yet."
    ConsoleParagraph:Set({
        Title = "Developer Console",
        Content = content
    })
end

ConsoleTab:CreateToggle({
    Name = "Show Console",
    CurrentValue = true,
    Flag = "ShowConsole",
    Callback = function(value)
        if value then
            RefreshConsole()
        else
            ConsoleParagraph:Set({
                Title = "Developer Console",
                Content = "Console hidden. Toggle it back on to view logs."
            })
        end
    end
})

ConsoleTab:CreateButton({
    Name = "Refresh Logs",
    Callback = function()
        RefreshConsole()
    end
})

ConsoleTab:CreateButton({
    Name = "Clear Logs",
    Callback = function()
        table.clear(Logs)
        RefreshConsole()
    end
})

AddLog("Developer console initialized.", "INFO")
AddLog("Player: " .. Player.Name, "INFO")
AddLog("Debug mode enabled.", "INFO")
RefreshConsole()

